<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} · {% endif %}연세노인전문요양원</title>
<meta name="description" content="{{ description or "전북 김제 용지면에 있는 정원 25명의 소규모 노인요양시설입니다. 입소 상담 063-542-2737 · 연중무휴 운영 · 면회 09:00–12:00 / 13:00–17:00" }}">
<meta name="theme-color" content="#1d336c">
<meta property="og:type" content="website">
<meta property="og:locale" content="ko_KR">
<meta property="og:site_name" content="연세노인전문요양원">
<meta property="og:title" content="{% if title %}{{ title }} · {% endif %}연세노인전문요양원">
<meta property="og:description" content="전북 김제 용지면, 정원 25명의 소규모 노인요양시설. 입소 상담 063-542-2737">
<link rel="stylesheet" href="/css/site.css">
</head>
<body>

{%- macro navlink(href, label) -%}
<a href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ label }}</a>
{%- endmacro -%}

<a class="skip" href="#main">본문 바로가기</a>

<header>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="연세노인전문요양원 홈으로">
      {% include "logo.njk" %}
    </a>

    <nav class="main" aria-label="주메뉴">
      <ul>
        <li{% if grp == "about" %} class="on"{% endif %}><a href="/about/vision/">요양원 소개</a>
          <ul class="drop">
            <li>{{ navlink('/about/vision/', '비전 / 운영원칙') }}</li>
            <li>{{ navlink('/about/greeting/', '인사말') }}</li>
            <li>{{ navlink('/about/org/', '조직도') }}</li>
            <li>{{ navlink('/about/facility/', '시설현황') }}</li>
            <li>{{ navlink('/about/map/', '오시는 길') }}</li>
          </ul>
        </li>
        <li{% if grp == "admission" %} class="on"{% endif %}><a href="/admission/">입주안내</a>
          <ul class="drop">
            <li>{{ navlink('/admission/', '입주안내') }}</li>
            <li>{{ navlink('/visit/', '면회 안내') }}</li>
          </ul>
        </li>
        <li{% if grp == "service" %} class="on"{% endif %}><a href="/service/">사업소개</a>
          <ul class="drop"><li>{{ navlink('/service/', '요양원') }}</li></ul>
        </li>
        <li{% if grp == "support" %} class="on"{% endif %}><a href="/support/donate/">후원안내</a>
          <ul class="drop">
            <li>{{ navlink('/support/donate/', '후원안내') }}</li>
            <li>{{ navlink('/support/volunteer/', '자원봉사') }}</li>
          </ul>
        </li>
        <li{% if grp == "board" %} class="on"{% endif %}><a href="/news/notice/">알림마당</a>
          <ul class="drop">
            <li>{{ navlink('/news/notice/', '공지사항') }}</li>
            <li>{{ navlink('/news/events/', '행사소식') }}</li>
            <li>{{ navlink('/news/gallery/', '포토갤러리') }}</li>
          </ul>
        </li>
      </ul>
    </nav>

    <a class="callbtn" href="tel:0635422737">상담 063-542-2737</a>
    <button class="burger" id="burger" type="button" aria-expanded="false">전체메뉴</button>
  </div>
</header>

<div class="drawer" id="drawer">
  <div class="panel" role="dialog" aria-label="전체 메뉴">
    <button class="close" id="drawerclose" type="button">닫기</button>
    <h3>요양원 소개</h3>
    {{ navlink('/about/vision/', '비전 / 운영원칙') }}
    {{ navlink('/about/greeting/', '인사말') }}
    {{ navlink('/about/org/', '조직도') }}
    {{ navlink('/about/facility/', '시설현황') }}
    {{ navlink('/about/map/', '오시는 길') }}
    <h3>입주안내</h3>
    {{ navlink('/admission/', '입주안내') }}
    {{ navlink('/visit/', '면회 안내') }}
    <h3>사업소개</h3>
    {{ navlink('/service/', '요양원') }}
    <h3>후원안내</h3>
    {{ navlink('/support/donate/', '후원안내') }}
    {{ navlink('/support/volunteer/', '자원봉사') }}
    <h3>알림마당</h3>
    {{ navlink('/news/notice/', '공지사항') }}
    {{ navlink('/news/events/', '행사소식') }}
    {{ navlink('/news/gallery/', '포토갤러리') }}
  </div>
</div>

<main id="main">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <h4>연세노인전문요양원</h4>
        <p>전북특별자치도 김제시 용지면<br>용지1길 18-4</p>
        <p>노인장기요양보험 지정 노인요양시설<br>2021년 8월 31일 지정 · 정원 25명</p>
      </div>
      <div>
        <h4>연락처</h4>
        <ul>
          <li>전화 <a href="tel:0635422737">063-542-2737</a></li>
          <li>팩스 063-542-2738</li>
          <li>연중무휴 운영</li>
        </ul>
      </div>
      <div>
        <h4>면회 안내</h4>
        <ul>
          <li>오전 09:00 – 12:00</li>
          <li>오후 13:00 – 17:00</li>
          <li>방문 전 연락 부탁드립니다</li>
        </ul>
      </div>
      <div>
        <h4>바로가기</h4>
        <ul>
          <li><a href="/admission/">입주안내</a></li>
          <li><a href="/visit/">면회 안내</a></li>
          <li><a href="/about/facility/">시설현황</a></li>
          <li><a href="/about/map/">오시는 길</a></li>
          <li><a href="/support/donate/">후원안내</a></li>
        </ul>
      </div>
    </div>
    <div class="fbot">
      <span>© 2026 연세노인전문요양원</span>
      <span>개인정보처리방침 및 이용약관은 정식 오픈 시 게시 예정</span>
    </div>
  </div>
</footer>

{# 모바일 전용 고정 바. 히어로 CTA 버튼은 모바일에서 숨기므로 항상 떠 있다. #}
<div class="callbar">
  <a href="tel:0635422737" class="p">전화 상담</a>
  <a href="/about/map/">오시는 길</a>
</div>

<script src="/js/site.js"></script>
{# Cloudflare Web Analytics — 쿠키 없는 방문 통계(동의 배너 불필요). 토큰은 공개값. #}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "271c2ce5a2ac4c53997b3ddf7b40c220"}'></script>
</body>
</html>
